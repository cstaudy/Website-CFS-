# cfs_zockt Creator Suite — runtime example
# Keine echten Secrets committen.

NODE_ENV=production
PORT=3000
APP_BASE_URL=https://your-domain.example
DATABASE_URL=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain.example/auth/tiktok/callback

CFS_TOKEN_ENCRYPTION_KEY=
CFS_ADMIN_CREATOR_IDS=
CFS_ADMIN_EMAILS=
CFS_LAUNCHER_BUILD_TARGET_VERSION=0.42.0
CFS_RELEASE_EVIDENCE_VERSION=0.42.0
CFS_LAUNCHER_RELEASE_REPO=cstaudy/CFS-TikTok-Backend
CFS_GITHUB_RELEASE_TOKEN=

CFS_STRIPE_SECRET_KEY=
CFS_STRIPE_WEBHOOK_SECRET=
CFS_STRIPE_PRICE_CREATOR_MONTHLY=
CFS_STRIPE_PRICE_PRO_MONTHLY=
CFS_BILLING_GRACE_DAYS=3

# Legacy *_VERIFIED Flags absichtlich nicht hier setzen.
# V38+ Evidence und V39+ Acceptance verwenden.

# Nur für Migration/Notfall; normalerweise NICHT aktivieren:
CFS_ALLOW_LEGACY_VERIFICATION_FLAGS=false
